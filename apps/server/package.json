{
  "name": "@prototyper/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototyper share server: serves demos to clients and stores their feedback",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@prototyper/shared": "workspace:*",
    "fastify": "^5.12.8",
    "sharp": "^0.35.5",
    "tar": "^7.5.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prototyper/overlay": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
