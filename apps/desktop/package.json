{
  "name": "@prototyper/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Prototyper desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "electron-vite build && node --check out/main/index.js && electron-builder --mac --publish never",
    "dist:release": "electron-vite build && node --check out/main/index.js && electron-builder --mac --publish never -c.mac.notarize=true"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prototyper/prototype-kit": "workspace:*",
    "@prototyper/shared": "workspace:*",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "simple-git": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tar": "^7.5.23",
    "zod": "^4.6.7"
  },
  "author": "Prototyper contributors",
  "license": "MIT",
  "homepage": "https://github.com/Aleloca/prototyper",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aleloca/prototyper.git",
    "directory": "apps/desktop"
  }
}
