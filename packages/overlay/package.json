{
  "name": "@prototyper/overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client review overlay injected into shared demos",
  "exports": {
    "./review.js": "./dist/review.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --target=es2020 --minify --outfile=dist/review.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
