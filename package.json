{
  "name": "prototyper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @prototyper/overlay build && pnpm --filter @prototyper/panel build && pnpm --filter @prototyper/server build && pnpm --filter @prototyper/mcp build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
