# Hostname of the panel; point its DNS (A record) to this server.
PANEL_HOST=prototyper.example.com
# On first start this address becomes the admin: the invite link is printed in the logs.
ADMIN_EMAIL=you@example.com
# Contact for Let's Encrypt (expiry notices). Optional.
ACME_EMAIL=you@example.com
# Optional. Without it a key is generated on first start and kept in the data volume.
# SECRET_KEY=
# THUMBNAILS=false
